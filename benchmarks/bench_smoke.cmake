# CI smoke test: the benchmark runs end to end and emits well-formed CSV.
# Says nothing about performance (tiny sizes, --allow-debug accepted).
set(OUT ${WORKDIR}/smoke_out)
file(REMOVE_RECURSE ${OUT})
execute_process(COMMAND ${BENCH} --smoke --allow-debug --out ${OUT}
                RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "lob_bench failed (${rc})\n${out}\n${err}")
endif()
foreach(f results.csv summary.csv latency_histogram.csv environment.txt)
  if(NOT EXISTS ${OUT}/${f})
    message(FATAL_ERROR "missing output ${f}")
  endif()
endforeach()
file(STRINGS ${OUT}/results.csv rows)
list(LENGTH rows n)
math(EXPR expected "1 + 5 * 2 * 2")   # header + 5 workloads x 2 reps x 2 engines
if(NOT n EQUAL expected)
  message(FATAL_ERROR "results.csv has ${n} lines, expected ${expected}")
endif()
list(GET rows 0 header)
foreach(col workload engine throughput_ops_per_sec p50_ns p99_ns valid_for_comparison cpu_model compiler)
  if(NOT header MATCHES "${col}")
    message(FATAL_ERROR "results.csv header lacks ${col}")
  endif()
endforeach()
file(STRINGS ${OUT}/summary.csv srows)
list(LENGTH srows sn)
if(NOT sn EQUAL 11)
  message(FATAL_ERROR "summary.csv has ${sn} lines, expected 11")
endif()
